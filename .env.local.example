# Copy this file to `.env.local` in the plugin root to run against a local
# backend instead of the proprietary https://terra-lab.ai.
#
#   cp .env.local.example .env.local
#
# `.env.local` is git-ignored. The plugin reads these keys at startup
# (src/ui/plugin.py:_create_client / _load_env_file).

# Point every API call at your local mock backend (mockserver/app.py).
TERRALAB_BASE_URL=http://127.0.0.1:8787

# Optional: skip the credit/quota pre-flight before each generation.
# Handy when iterating on the mock so generation never blocks on /usage.
SKIP_TRIAL_CHECK=true

# Optional: enable the plugin's dev mode (extra logging, debug artifacts).
DEBUG=true
